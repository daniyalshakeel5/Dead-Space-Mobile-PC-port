<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dead Space Mobile — PC Launcher" Width="1090" Height="755" MinWidth="940" MinHeight="680" Background="#0B1114" Foreground="#D7E5E8" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#203138"/><Setter Property="Foreground" Value="#E2F2F1"/><Setter Property="BorderBrush" Value="#395158"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0C181B"/><Setter Property="Foreground" Value="#DBF5F3"/><Setter Property="BorderBrush" Value="#385358"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C2E1E0"/><Setter Property="Margin" Value="0,10,0,10"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#121F23"/><Setter Property="BorderBrush" Value="#33474C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111C20" BorderBrush="#A3383B" BorderThickness="0,0,2,0" Padding="20,28"><DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="DEAD SPACE" FontSize="23" FontWeight="Bold" Foreground="#ECF8F8" Margin="0,0,0,0"/><TextBlock Text="MOBILE // PC WRAPPER" FontSize="10" FontWeight="SemiBold" Foreground="#EE6668" Margin="0,0,0,33"/>
    <Button Name="HomeNav" Content="01   HOME / SETUP" HorizontalContentAlignment="Left"/><Button Name="GraphicsNav" Content="02   GRAPHICS" HorizontalContentAlignment="Left"/><Button Name="ControlsNav" Content="03   CONTROLS" HorizontalContentAlignment="Left"/><Button Name="DepsNav" Content="04   RUNTIME" HorizontalContentAlignment="Left"/><Button Name="AboutNav" Content="05   ABOUT" HorizontalContentAlignment="Left"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><Border Height="2" Background="#A3383B" Margin="0,0,0,16"/><TextBlock Text="USG ISHIMURA // STATUS" Foreground="#68C5C4" FontSize="11"/><TextBlock Text="Guest ARM32 runtime: incomplete" Foreground="#B4CBCE" FontSize="11"/><TextBlock Text="Launcher v0.1  •  Asset-free" FontSize="10" Foreground="#819B9E"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="28,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="178"/></Grid.RowDefinitions>
   <DockPanel><Border DockPanel.Dock="Right" Background="#392026" CornerRadius="2" Padding="10,6"><TextBlock Text="WARNING  //  SYSTEM NOT INITIALIZED" Foreground="#FF9090" FontSize="10" Margin="0"/></Border><TextBlock Text="DEAD SPACE  /  ASSET INITIALIZATION" Foreground="#78C4C6" FontSize="12" Margin="0,0,0,18"/></DockPanel>
   <Grid Grid.Row="1">
    <ScrollViewer Name="HomePage" VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Prepare your game files" FontSize="26" FontWeight="SemiBold" Foreground="#EFF7F7"/>
     <TextBlock Text="Import your own Xperia Play files and optional Reanimated enhancement. No copyrighted content is included in this launcher." Foreground="#9BBFC0"/>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="01   ORIGINAL XPERIA PLAY CAMPAIGN" Foreground="#80D8D2" FontWeight="SemiBold"/><TextBlock Text="Required: Vita-ready Xperia Play v1.1.33 deadspace.zip" Foreground="#AFC6C6"/><TextBox Name="GamePath" IsReadOnly="True"/><WrapPanel><Button Name="BrowseZip" Content="Choose game ZIP..."/><Button Name="OpenOriginal" Content="Open installed originals"/></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="02   REANIMATED HD ENHANCEMENTS" Foreground="#80D8D2" FontWeight="SemiBold"/><TextBlock Text="Optional: your own Dead Space Reanimated v1.2/v1.3 APK (222 HD KTX textures in v1.3)." Foreground="#AFC6C6"/><TextBox Name="HdPath" IsReadOnly="True"/><WrapPanel><Button Name="BrowseApk" Content="Choose Reanimated APK..."/><Button Name="ClearApk" Content="Use original textures"/><Button Name="OpenHd" Content="Open HD files"/></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SETUP READINESS" Foreground="#80D8D2" FontWeight="SemiBold"/><TextBlock Name="OriginalStatus"/><TextBlock Name="HdStatus"/><TextBlock Name="EngineStatus"/><WrapPanel><Button Name="Recheck" Content="Refresh checks"/><Button Name="OpenInstall" Content="Open installation folder"/></WrapPanel></StackPanel></Border>
     <WrapPanel><Button Name="InstallAssets" Content="INSTALL / VERIFY GAME FILES" Background="#812F35" BorderBrush="#BD4D52" FontWeight="Bold" Padding="24,14"/><Button Name="QemuBoot" Content="TEST GAME BOOT (QEMU)" Background="#275B62" BorderBrush="#80C4CD" Padding="22,14" IsEnabled="False"/><Button Name="Launch" Content="PLAY (NOT READY)" Background="#356B6E" Padding="22,14" IsEnabled="False"/></WrapPanel>
     <TextBlock Text="The QEMU check runs the REAL Xperia engine headlessly using an optional Linux/WSL2 runtime. This test does not yet open an interactive game window." Foreground="#AFC4C6" FontSize="12"/>
     <TextBlock Name="RunStatus" Text="Select your original game ZIP to begin." Foreground="#ADC7C7"/>
    </StackPanel></ScrollViewer>
    <ScrollViewer Name="GraphicsPage" Visibility="Collapsed"><StackPanel>
     <TextBlock Text="Visual enhancements" FontSize="26"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TEXTURE SOURCE" Foreground="#80D8D2"/><CheckBox Name="EnableHd" Content="Prefer Reanimated HD textures once compatible"/><TextBlock Text="HD KTX files are installed in a separate folder. The original Xperia ATC texture mapping is not connected to the renderer yet; changing this selection does not make HD textures visible in the current build." Foreground="#B1C6C7"/><TextBlock Name="HdDetails" Foreground="#80D8D2"/><Button Name="BrowseApkGraphics" Content="Select Reanimated APK" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="RENDERING PROFILE" Foreground="#80D8D2"/><ComboBox Name="Quality" Width="240" HorizontalAlignment="Left" SelectedIndex="1" Margin="0,0,0,12"><ComboBoxItem Content="Original / low-end GPU"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Enhanced (future)"/></ComboBox><TextBlock Text="Preference is saved for the future wrapper renderer. Until the ARM game runs, no visual profile is applied." Foreground="#AFC4C6"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer Name="ControlsPage" Visibility="Collapsed"><StackPanel>
     <TextBlock Text="DualShock 4 controls" FontSize="26"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PLAYSTATION 4 / TOUCHPAD" Foreground="#80D8D2"/><TextBlock Text="Left stick — character movement&#10;Right stick — camera control&#10;Touchpad — menus and touch interactions&#10;Cross — confirm / interact&#10;Circle — back / cancel&#10;D-pad — navigate menus" FontSize="15"/><TextBlock Text="The host-side DS4 touch translation is implemented in the experimental input branch. It still requires connection to live Xperia guest JNI callbacks." Foreground="#9BBFC0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer Name="DepsPage" Visibility="Collapsed"><StackPanel>
     <TextBlock Text="Runtime status" FontSize="26"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ARM32 → x86-64 COMPATIBILITY" Foreground="#80D8D2"/><TextBlock Text="QEMU is now the primary route for the original Xperia engine's initial startup. The GPL-3.0 ARM/Linux loader already demonstrates real game startup upstream. Our Windows launcher can run a user-local headless boot check; an interactive Windows gameplay window is not yet integrated. Dynarmic remains an experimental alternative." Foreground="#BDD2D2"/><TextBlock Name="RuntimeStatus" Foreground="#FF858B"/><TextBlock Name="QemuStatus" Foreground="#80D8D2"/><TextBlock Text="PRIMARY BOOT BACKEND: QEMU-ARM + GPL ARM/Linux loader. Optional prerequisites: WSL2 Linux, Docker Desktop in Linux-container mode, and WSL Docker integration. You can opt in to a local engine-startup check without using a terminal. This first test runs offscreen; PS4 controller and interactive window support remain unverified." Foreground="#BDD2D2"/><Button Name="OpenProject" Content="Open development branch" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="NO SYSTEM DEPENDENCIES FOR THE LAUNCHER" Foreground="#80D8D2"/><TextBlock Text="This is the Windows PowerShell 5.1 / WPF launcher from our Diamond Rush PC port, adapted for Dead Space. It runs on standard Windows 10/11 without Java, Python, Qt, or system PATH changes."/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <ScrollViewer Name="AboutPage" Visibility="Collapsed"><StackPanel><TextBlock Text="Project &amp; credits" FontSize="26"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ORIGINAL-FILE-FIRST" Foreground="#80D8D2"/><TextBlock Text="This asset-free launcher adapts the user-owned Diamond Rush N73 v0.7.0 WPF launcher architecture, navigation, activity log, and local installation model. Xperia Play files belong to their rights holders; Reanimated HD resources are provided independently by the user."/><TextBlock Text="Reanimated: GINESTR0. Xperia Play Vita port: v-atamanenko and contributors. EapRules: Android compatibility research. Dynarmic: ARM JIT research." Foreground="#AFC4C6"/></StackPanel></Border></StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14"><DockPanel><WrapPanel DockPanel.Dock="Top"><TextBlock Text="ACTIVITY  /  INSTALLATION LOG" Foreground="#80D8D2" Margin="0,7,20,0"/><Button Name="CopyLog" Content="Copy log" Padding="8,4"/><Button Name="OpenLogs" Content="Open logs" Padding="8,4"/></WrapPanel><TextBox Name="Log" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0"/></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
